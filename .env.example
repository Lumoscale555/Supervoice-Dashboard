# Session cookie signing secret — set a long random value in production.
# If left blank, a random one is generated per process start (fine for local
# dev; sessions just won't survive a restart until you set a real value).
SESSION_SECRET=

# Supabase project used to store client (tenant) records — name, login,
# Sonex API key, agent scope, billing rates. Run server/supabase.sql once
# against this project first. Leave both blank to fall back to a local JSON
# file (server/data/tenants.json) for development.
#   SUPABASE_URL: Project Settings -> API -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role key
#   (server-side only — never expose this key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Super admin login (creates/edits clients in the admin console at /admin).
# Required — there is no hardcoded fallback. Admin login is refused entirely
# until both are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: seed one demo client on first run when using the local file store
# (has no effect once Supabase is configured). Leave both blank to start with
# no clients and create your first one from the admin console instead.
DEMO_SEED_USERNAME=
DEMO_SEED_PASSWORD=

# Port for the API + dashboard
PORT=8787

# Default display timezone (each client's own Sonex API key and agent scope
# are configured per-client in the admin console, not here).
TIMEZONE=Asia/Kolkata
